const int LED = 13;
const int Sensor = A0; /* setting A0 input as Analog Input */


int level; 
const int threshold = 60; /* determins the threshold value of sound intensity */

void setup()
{
  pinMode (LED, OUTPUT);
  Serial.begin(9600);
}

void loop(){
  level= analogRead(Sensor);

  //Converting the analog level to decibels (dB)
  float dB = 20 * log10(float(level) / 1023);

  // Prinint the noise in the Analog value and decibel level
  Serial.print("Analog Value: ");
  Serial.print(level);
  Serial.print(" | Decibels: ");
  Serial.println(dB); /* pushes to the next line after printing dB */


  if (level > threshold) /* if the level is greater than the thresholdvalue, the LED will turn on and off after 1 second */
  {
    digitalWrite(LED, HIGH);
    delay(1000);
    digitalWrite(LED, LOW);
  }
  else
  {
    digitalWrite(LED,LOW);
  }
}